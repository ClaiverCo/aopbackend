@model IEnumerable<Medico>
@{
    ViewData["Title"] = "Corpo Clínico";
}

<h2>@ViewData["Title"]</h2>
<p class="text-muted">Escolha o profissional pela especialidade ao agendar uma consulta.</p>

@foreach (var grupo in Model.GroupBy(m => m.Especialidade))
{
    <h5 class="mt-4">@grupo.Key</h5>
    <ul class="list-group mb-2">
        @foreach (var medico in grupo)
        {
            <li class="list-group-item">
                <strong>Dr(a). @medico.Nome</strong>
                <span class="text-muted">· @medico.Crm</span>
                <div class="small text-muted">@medico.Resumo</div>
            </li>
        }
    </ul>
}

<a asp-controller="Consultas" asp-action="Create" class="btn btn-primary mt-2">Agendar consulta</a>
