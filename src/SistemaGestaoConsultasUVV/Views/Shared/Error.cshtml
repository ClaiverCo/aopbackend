@model ErrorViewModel
@{
    ViewData["Title"] = "Erro";
}

<h1 class="text-danger">Ocorreu um erro.</h1>
<h2 class="text-danger">Não foi possível processar a sua solicitação.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>ID da requisição:</strong> <code>@Model.RequestId</code>
    </p>
}
